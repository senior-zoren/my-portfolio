---
// src/components/Hero.astro
import { getCollection, type CollectionEntry } from 'astro:content';

const allProjects = await getCollection('projects');

// Government / Enterprise Projects
const dictProjects = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.type === 'dict')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Featured Active Project (App-Repo)
const featuredProject = allProjects.find((p) => p.id.includes('app-repo') || p.data.title.toLowerCase().includes('app-repo'));

// Remaining Personal & Independent Projects (VRS, MARIS)
const remainingPersonalProjects = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.type === 'personal' && p.id !== featuredProject?.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const techStack = [
  "PHP",
  "Python",
  "Laravel",
  "CodeIgniter",
  "JavaScript",
  "Alpine.js",
  "Tailwind CSS",
  "Bootstrap",
  "MySQL",
  "PostgreSQL",
  "Git"
];

// Helper function to resolve status badge labels safely
function getProjectStatus(project: CollectionEntry<'projects'>): string {
  const customStatus = (project.data as Record<string, unknown>).status;
  if (typeof customStatus === 'string') return customStatus;

  const isVRS = project.id.includes('vrs') || 
                project.data.title.toLowerCase().includes('van') || 
                project.data.title.toLowerCase().includes('vehicle');

  return isVRS ? "Client-Ready System" : "Capstone / R&D";
}
---

