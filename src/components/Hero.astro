        </div>

        <div class="space-y-2">
          <h3 class="text-xl font-bold text-white hover:text-emerald-400 transition-colors">
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${featuredProject.id}`}>
